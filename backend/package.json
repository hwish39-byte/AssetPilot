{
  "name": "assetpilot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "NODE_ENV=test node --test --import tsx \"src/**/*.test.ts\"",
    "perpl:check": "tsx scripts/check-perpl-connection.ts",
    "perpl:analytics-check": "tsx scripts/check-perpl-analytics.ts",
    "perpl:agent-check": "tsx scripts/check-perpl-agent.ts",
    "perpl:trade-check": "tsx scripts/check-perpl-trade.ts",
    "perpl:receipt-check": "tsx scripts/check-perpl-receipts.ts",
    "perpl:realtime-check": "tsx scripts/check-perpl-realtime.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
